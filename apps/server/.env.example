PORT=4000
NODE_ENV=development
# Every origin allowed to call the API with credentials: the web app and the widget frame, comma-separated.
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
# The web app (links inside invitation emails) and the widget frame (postMessage / CORS checks).
WEB_ORIGIN=http://localhost:3000
WIDGET_ORIGIN=http://localhost:5173

# Neon (development and production). Use the pooled connection string from the Neon console.
# For the local docker Postgres instead (commented out in docker-compose.yml), use
# postgresql://relaydesk:relaydesk@localhost:5432/relaydesk
DATABASE_URL="postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<database>?sslmode=require&channel_binding=require"

# Three DIFFERENT random secrets of at least 32 characters each; the server refuses to start otherwise.
# Generate each with: openssl rand -hex 32
# Google sign-in: the OAuth client id (Google Cloud Console → Credentials → Web client). Leave empty to turn it off.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

JWT_SECRET=
JWT_REFRESH_SECRET=
VISITOR_TOKEN_SECRET=

# Email goes out through the Gmail API as one Google account — no domain needed. Setup, step by step: docs/EMAIL.md.
# The OAuth client is a "Web application" client; GMAIL_REDIRECT_URI must be registered on it exactly.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:4000/api/auth/gmail/callback
# Printed in the server console when you open http://localhost:<PORT>/api/auth/gmail and approve as the sending account.
GMAIL_REFRESH_TOKEN=
# Production only: "true" switches that authorisation page on while you re-authorise, then back to "false".
GMAIL_OAUTH_SETUP=false
# Must use the address of that same account (Gmail rewrites any other); the name is what recipients see.
EMAIL_FROM="RelayDesk <your-sending-account@gmail.com>"

# Proxies in front of this app whose client-IP headers (X-Forwarded-For, cf-connecting-ip)
# may be believed, as comma-separated IPv4/IPv6 CIDRs. Express and the rate limiter both use this
# list. It must name the machine that opens the TCP connection to this app, and nothing else.
#   - Behind a load balancer or reverse proxy (nginx, Render, Railway, an ALB...), list ITS address
#     range here. Otherwise every request appears to come from the proxy, and all users share a
#     single rate-limit bucket: a handful of bad logins would block login for everyone.
#   - On Render: requests go Cloudflare -> Render load balancer (10.x) -> a proxy inside the
#     instance, and that proxy is what connects to this app, over loopback. Use 127.0.0.1/32.
#     Render doesn't document this; it was confirmed by logging req.socket.remoteAddress, so
#     re-check that way if the rate limiter starts treating all users as one. Do NOT add
#     Cloudflare's, Render's 10.x or Vercel's ranges: none of them connects to this app directly.
#   - Cloudflare in front of your OWN server (it connects to you directly): list
#     https://www.cloudflare.com/ips-v4 and ips-v6.
#   - Exposed directly to the internet, leave it EMPTY: a trusted header lets any client choose
#     its own rate-limit bucket.
TRUSTED_PROXY_CIDRS=
# Shows how the rate limiter identifies the caller at /debug-ip. Leave false outside a deploy check.
DEBUG_IP_ENDPOINT=false

# BullMQ dashboard at /admin/queues. Its job payloads contain invitation tokens, so it stays off
# unless switched on here, and needs credentials when on.
ENABLE_QUEUE_DASHBOARD=false
QUEUE_DASHBOARD_USER=
QUEUE_DASHBOARD_PASSWORD=

# Production only: "true" runs the background jobs inside this API process (one free web service). Default "false":
# run `pnpm start:worker` as its own process.
RUN_WORKERS_IN_API=false

REDIS_HOST=localhost
REDIS_PORT=6381
# Leave empty for the local docker Redis; set for a hosted one (e.g. Redis Cloud). A hosted
# database must use the `noeviction` policy, or BullMQ warns and can lose jobs.
REDIS_USERNAME=
REDIS_PASSWORD=

# Response cache — a SEPARATE Redis (docker-compose service `redis-cache`, port 6382). It must be
# allowed to evict (volatile-lru) while the instance above must never evict, or BullMQ loses jobs.
CACHE_REDIS_HOST=localhost
CACHE_REDIS_PORT=6382
# Default to REDIS_USERNAME / REDIS_PASSWORD when unset.
CACHE_REDIS_USERNAME=
CACHE_REDIS_PASSWORD=

# How long a homepage demo workspace lives before the maintenance job deletes it.
DEMO_TTL_HOURS=24
DEMO_SESSIONS_PER_HOUR=10   # raise it for the e2e run: each test starts its own demo
