{
  "name": "server",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "worker": "tsx watch src/worker.ts",
    "build": "tsc --noEmit && esbuild src/index.ts src/worker.ts --bundle --packages=external --platform=node --format=esm --target=node22 --sourcemap --outdir=dist",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --forceExit",
    "contract:emit": "prisma contract emit",
    "db:plan": "prisma contract emit && prisma migration plan --from db --name",
    "db:apply": "pnpm run db:sql && prisma db migrate --advance-ref db && prisma db sign",
    "db:sql": "tsx src/scripts/write-migration-sql.ts",
    "db:deploy": "prisma db migrate && tsx src/scripts/defer-member-refs.ts",
    "load": "tsx src/scripts/load-test.ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "mail:test": "tsx src/scripts/send-test-mail.ts",
    "db:check": "tsx src/scripts/test-checkpoint.ts"
  },
  "dependencies": {
    "@bull-board/api": "^8.6.1",
    "@bull-board/express": "^8.6.1",
    "@prisma/cli-engine": "^0.4.0",
    "@prisma/orm-postgres": "8.0.0-rc.11",
    "@repo/types": "workspace:^",
    "@socket.io/redis-adapter": "^8.3.0",
    "argon2": "^0.45.1",
    "bullmq": "^5.81.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "google-auth-library": "^9.15.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "ipaddr.js": "^2.5.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "pg": "^8.23.1",
    "proxy-addr": "^2.0.8",
    "socket.io": "^4.8.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:^",
    "@repo/typescript-config": "workspace:^",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.20.4",
    "@types/proxy-addr": "^2.0.3",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "jest": "^30.5.2",
    "prisma": "8.0.0-rc.15",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15",
    "typescript": "5.9.2"
  }
}
